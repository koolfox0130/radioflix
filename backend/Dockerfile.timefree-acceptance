FROM python:3.14-slim
ARG RADIOFLIX_GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${RADIOFLIX_GIT_SHA}"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir fastapi uvicorn
COPY app.py /app/app.py
COPY radioflix /app/radioflix
RUN chmod -R a+rX /app/radioflix /app/app.py
USER 10001:20000
ENTRYPOINT ["python", "-m", "radioflix.timefree.acceptance"]
